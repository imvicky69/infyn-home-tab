{
  "manifest_version": 3,
  "name": "Infyn Home Tab",
  "version": "1.0.0",
  "description": "A sleek, productive new tab homescreen dashboard with widgets, quick shortcuts, notes, and search.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Infyn • Screenshots & Focus Timer",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "logo.png"
  }
}
